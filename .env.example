# Invoice Keeper — пример настроек.
# Скопируйте в .env и заполните: cp .env.example .env
# Файл .env в git не попадает.

# --- HTTP -------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Часовой пояс: по нему считаются «сегодня» и просрочка.
TIMEZONE=Europe/Moscow

# Путь к файлу SQLite. Относительный — от каталога запуска.
DATABASE_PATH=data/invoice-keeper.db

# --- Администратор ----------------------------------------------------------
# Создаётся при первом запуске и дальше управляется только через .env:
# при рестарте пароль в базе приводится к этому значению.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# --- Сессии -----------------------------------------------------------------
# JWT_SECRET обязательно смените: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
SESSION_TTL_HOURS=24

# Защита от перебора пароля: попыток с одного адреса за окно.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=5

# --- Telegram ---------------------------------------------------------------
# Достаточно только токена: напоминания приходят всем, кто написал боту /start.
# TELEGRAM_CHAT_ID — необязательная автоподписка: чат добавится, только если в
# базе ещё нет ни одного подписчика. Узнать ID чата можно командой /id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Частота проверки напоминаний, секунд.
REMINDER_INTERVAL_SECONDS=60
